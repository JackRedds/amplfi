Bootstrap: localimage
From: /sw/external/NGC/pytorch_25.10-py3.sif

%environment
    export PROJECT_DIR="/projects/bcse/"
    export CONTAINER_WORKDIR="/amplfi/"

%files
. /amplfi/

%post
set -e

python -m pip install --upgrade pip && python -m pip install uv

python -m pip install "numpy>=1.26,<2.0"
python -m pip install "numba>=0.59,<0.60"
python -m pip install "torch>=2.3.0" "torchvision>=0.18.0" "torchaudio" --index-url https://download.pytorch.org/whl/cu121

cd /amplfi/ \
    && uv export --format requirements-txt -o requirements.txt.tmp --no-hashes \
    && cat requirements.txt.tmp | grep -v 'numpy==' | grep -v 'torch==' | grep -v 'torchaudio==' | grep -v 'torchvision==' | grep -v 'triton' | grep -v 'protobuf' | grep -v 'nvidia' > requirements.txt \
    && rm requirements.txt.tmp \
    && python -m pip install -r requirements.txt --no-deps \
    && python -m pip install -e . --no-deps


%runscript
#!/bin/bash
exec "$@"